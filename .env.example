# Set these on the server (Netlify env), never in the app and never commit real values.
#   netlify env:set OPENROUTER_API_KEY "sk-or-v1-..." --secret
#   netlify env:set SUPABASE_SERVICE_ROLE_KEY "sb_secret_..." --secret
OPENROUTER_API_KEY=
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Defaults are used when these are unset.
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
DAILY_PHOTO_LIMIT=20

# Apple and Google sign-in are turned on in the Supabase dashboard, not here.
# Add youai://login-callback to the Auth redirect allow list.
