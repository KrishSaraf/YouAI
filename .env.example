# Set these on the server (Netlify env), never in the app and never commit real values.
#   netlify env:set NVIDIA_API_KEY "nvapi-..." --secret
#   netlify env:set SESSION_SECRET "$(openssl rand -base64 32)" --secret
NVIDIA_API_KEY=
SESSION_SECRET=

# Optional. Defaults are used when these are unset.
NVIDIA_VISION_MODEL=meta/llama-3.2-90b-vision-instruct
NVIDIA_IMAGE_ENCODING=openAIImageURL
APPLE_BUNDLE_ID=com.ht.YouAI
DAILY_PHOTO_LIMIT=20

# Required before App Store submission so Delete account can disconnect Sign in with Apple.
# Create the key in Apple Developer > Keys, with Sign in with Apple enabled.
# APPLE_PRIVATE_KEY is the contents of the downloaded .p8 file.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
