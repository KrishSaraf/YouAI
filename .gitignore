# Generated by XcodeGen from project.yml — never commit it.
*.xcodeproj

# Xcode
build/
DerivedData/
*.xcuserstate
*.xcuserdatad
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/
Packages/
Package.resolved

# macOS
.DS_Store

# Secrets — the NVIDIA API key lives in the iOS Keychain, never on disk,
# but keep this here so no local override file can slip in.
*.env
Secrets.swift
